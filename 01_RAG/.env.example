# ── LLM API Keys ─────────────────────────────────────────────────
# DeepSeek 用于聊天/改写；DashScope 可继续用于 Embedding
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DASHSCOPE_API_KEY=
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# ── 模型选择 ─────────────────────────────────────────────────────
# 主对话模型（DeepSeek）
CHAT_MODEL=deepseek-v4-pro
# 问题改写 / 日期抽取（DeepSeek 轻量模型）
REWRITE_MODEL=deepseek-v4-flash
# Embedding 模型（DashScope 默认；也可配 OpenAI embedding）
EMBEDDING_MODEL=qwen3.7-text-embedding

# ── RAG 参数 ─────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
SEMANTIC_TOP_K=50
BM25_TOP_K=50
RRF_TOP_K=80
RRF_K=60
MAX_CHILDREN_PER_PARENT_PRE_RRF=3
RERANK_TOP_K=15
BUSINESS_FUSION_TOP_K=15
DIVERSIFIED_PARENT_TOP_K=8
FINAL_PARENT_TOP_K=6
FINAL_TOP_K=6
MAX_PARENTS_PER_DOCUMENT=2
SIMILARITY_DEDUP_THRESHOLD=0.92
MMR_LAMBDA=0.70
FINAL_CONTEXT_TOKEN_BUDGET=6000
MULTI_EVIDENCE_BONUS_PER_CHILD=0.02
MULTI_EVIDENCE_BONUS_CAP=0.05
BUSINESS_RERANK_WEIGHT=0.70
BUSINESS_RRF_WEIGHT=0.15
BUSINESS_AUTHORITY_WEIGHT=0.07
BUSINESS_FRESHNESS_WEIGHT=0.05
BUSINESS_VERSION_WEIGHT=0.03
SEMANTIC_WEIGHT=0.6
SIMILARITY_THRESHOLD=0.3
MAX_HISTORY_MESSAGES=10

# ── 路径配置 ─────────────────────────────────────────────────────
DOCUMENTS_DIR=./data/documents
VECTORSTORE_DIR=./data/vectorstore

# ── Elasticsearch 8.19 Child 检索索引 ────────────────────────────
ES_URL=http://127.0.0.1:9200
ES_PHYSICAL_INDEX=rag-child-chunks-v1
ES_INDEX_READ_ALIAS=rag-child-chunks-read
ES_INDEX_WRITE_ALIAS=rag-child-chunks-write
ES_NUMBER_OF_SHARDS=1
ES_NUMBER_OF_REPLICAS=0
ES_VERIFY_CERTS=false
ES_USERNAME=
ES_PASSWORD=
ES_API_KEY=
ES_CA_CERTS=
ES_REQUEST_TIMEOUT=30
ES_MAX_RETRIES=3
ES_BULK_CHUNK_SIZE=500
ES_EMBEDDING_DIMS=1024
ES_DENSE_NUM_CANDIDATES=300

# ── Cross-Encoder Rerank（Streamlit 默认开启；做 baseline 可设为 false）────
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-base
# 初始教学阈值；发布前必须用 Dev 标注集校准
RERANK_TOP_N=15
RERANK_SCORE_THRESHOLD=0.0
RERANK_BATCH_SIZE=16
RERANK_DEVICE=
